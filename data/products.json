  "testimonials": [
    {
      "text": "Zawsze odwiedzam tę piekarnię, gdy jestem w okolicy! Ich ciasta są nie do pobicia, a chleb na zakwasie smakuje jak domowy. Naprawdę warto!",
      "author": "Anna M."
    },
    {
      "text": "Obsługa w piekarni jest zawsze miła i profesjonalna. A co najważniejsze, wypieki są pyszne! Chleb, który kupiłem, zniknął w mgnieniu oka.",
      "author": "Ewa L."
    },
    {
      "text": "W tej piekarni zawsze można liczyć na świeże wypieki! Chleb na zakwasie jest moim ulubionym, a do tego obsługa jest zawsze uśmiechnięta i pomocna.",
      "author": "Bartek K."
    }
