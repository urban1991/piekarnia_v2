NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
# tylko lokalnie, do jednorazowych skryptów (scripts/seed-sanity.ts) — nie dodawać w Vercel
SANITY_API_WRITE_TOKEN=
# ten sam sekret wpisany w Sanity → Manage → API → Webhooks (wygeneruj: openssl rand -hex 32)
SANITY_WEBHOOK_SECRET=
# sekret zadań cron Vercela (app/api/cron/refresh); w Vercel jako Secret (openssl rand -hex 32)
CRON_SECRET=
# opcjonalnie: adres strony dla sitemap/canonical/podglądów linków; bez niego domena produkcyjna z Vercela
NEXT_PUBLIC_SITE_URL=
# notatki robocze na stronie (godziny przykładowe itp.); usuń przed startem
NEXT_PUBLIC_SHOW_DEV_NOTES=true
